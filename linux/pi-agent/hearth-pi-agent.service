[Unit]
Description=Hearth-Connect Pi Agent
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# User is set at install time by install.sh to the account running it.
User=__AGENT_USER__
WorkingDirectory=/opt/hearth-pi-agent
EnvironmentFile=/opt/hearth-pi-agent/config.env
Environment=CONFIG_FILE=/opt/hearth-pi-agent/config.env
ExecStart=/usr/bin/python3 /opt/hearth-pi-agent/pi-agent.py
Restart=always
RestartSec=5
# Allow the non-root agent to bind the captive portal to port 80.
# (Use AmbientCapabilities only — narrowing CapabilityBoundingSet would drop
# CAP_AUDIT_WRITE and break sudo for the child nmcli/dnsmasq invocations.)
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
